# App
APP_ENV=local
DATABASE_URL=sqlite:///./workflow_legion.db
REDIS_URL=redis://localhost:6379/0

# Primary LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Band API base
BAND_BASE_URL=https://app.band.ai/api/v1
BAND_ROOM_ID=
BAND_CHAT_ID=

# Current/legacy Band posting identity
# Keep these for the current backend path until role-specific posting is fully wired.
BAND_API_KEY=
BAND_AGENT_ID=
BAND_DEFAULT_MENTION_HANDLES=your-human-observer-handle

# Remote Band agents
# Agent IDs map Band receive @[[...]] mention tokens. Keep real values local.

# Remote Triage Agent
BAND_TRIAGE_AGENT_ID=
BAND_TRIAGE_HANDLE=your-triage-agent-handle
BAND_TRIAGE_AGENT_API_KEY=

# Remote Threat Intel Agent
BAND_THREAT_INTEL_AGENT_ID=
BAND_THREAT_INTEL_HANDLE=your-threat-intel-agent-handle
BAND_THREAT_INTEL_AGENT_API_KEY=

# Remote Forensics Agent
BAND_FORENSICS_AGENT_ID=
BAND_FORENSICS_HANDLE=your-forensics-agent-handle
BAND_FORENSICS_AGENT_API_KEY=

# Remote Compliance Agent
BAND_COMPLIANCE_AGENT_ID=
BAND_COMPLIANCE_HANDLE=your-compliance-agent-handle
BAND_COMPLIANCE_AGENT_API_KEY=

# Remote Incident Commander Agent
BAND_COMMANDER_AGENT_ID=
BAND_COMMANDER_HANDLE=your-commander-agent-handle
BAND_COMMANDER_AGENT_API_KEY=

# Featherless
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=

# AI/ML API
AIML_API_KEY=
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini

# Legacy AI/ML API env aliases
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
AIMLAPI_MODEL=gpt-4o-mini

# Autonomous task-agent runtime
AUTONOMOUS_AGENT_PROVIDER_MODE=auto

# Hosted judge runtime
HOSTED_RUNTIME_AUTOSTART=true
HOSTED_RUNTIME_DRY_RUN=false
HOSTED_RUNTIME_INCIDENT=WL-INC-001
HOSTED_RUNTIME_STATE_DIR=.workflow-legion-state
HOSTED_RUNTIME_MISSION_CONTROL_EXPORT=.workflow-legion-state/mission-control-status.hosted.json
HOSTED_RUNTIME_MAX_TURNS=12
HOSTED_RUNTIME_POLL_INTERVAL=5
HOSTED_RUNTIME_MESSAGE_LIMIT=25
HOSTED_RUNTIME_BASELINE_EXISTING=true
HOSTED_RUNTIME_STOP_AFTER_COMPLETE=true
HOSTED_RUNTIME_RESTART_AFTER_COMPLETE=true
HOSTED_RUNTIME_RESTART_DELAY=2
HOSTED_RUNTIME_DEBUG_RECEIVE=false

# Native.Builder / NativelyAI
NATIVE_BUILDER_PROJECT_URL=
NATIVE_BUILDER_NOTES_URL=

# Provider Router
LLM_PROVIDER=aimlapi
LLM_FALLBACK_PROVIDER=featherless
